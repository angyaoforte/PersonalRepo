# Copy these into Netlify → Site settings → Environment variables.
# NEVER commit real values. This file only documents the names.

# Required: your Anthropic API key (kept server-side, never sent to the browser)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: a shared team code. If set, the app requires it before it will answer.
# Leave unset/empty to make the app open to anyone with the link.
ACCESS_CODE=

# Optional: override the models. Set these to model IDs your key can access.
# (Model names change over time — check your Anthropic console for current IDs.)
MODEL_FAST=claude-3-5-haiku-latest
MODEL_SMART=claude-3-5-sonnet-latest
